map $uri $lab_route {
    default $uri;
    ~^/auth/session/ /auth/session/redacted;
}
log_format lab_json escape=json '{"timestamp":$msec,"service":"waf","client_ip":"$remote_addr","status":$status,"duration_seconds":$request_time,"route":"$lab_route","method":"$request_method"}';
access_log /logs/waf.jsonl lab_json;

server {
    listen 8080;
    server_name _;
    server_tokens off;
    include /etc/nginx/lab-proxy.conf;
}
server {
    listen 8443 ssl;
    server_name _;
    server_tokens off;
    ssl_certificate /run/secrets/tls_cert;
    ssl_certificate_key /run/secrets/tls_key;
    ssl_protocols TLSv1.2 TLSv1.3;
    include /etc/nginx/lab-proxy.conf;
}
