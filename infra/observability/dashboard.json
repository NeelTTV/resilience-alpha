{
  "uid": "resilience-alpha", "title": "Resilience Alpha", "schemaVersion": 39,
  "tags": ["workshop"], "refresh": "5s", "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {"id": 1, "title": "Disponibilité des services", "type": "stat", "gridPos": {"x": 0, "y": 0, "w": 8, "h": 6}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "up", "legendFormat": "{{job}}"}]},
    {"id": 2, "title": "Requêtes par seconde", "type": "timeseries", "gridPos": {"x": 8, "y": 0, "w": 16, "h": 6}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum by(service, status) (rate(http_requests_total[1m]))", "legendFormat": "{{service}} {{status}}"}]},
    {"id": 3, "title": "Latence p95 (secondes)", "type": "timeseries", "gridPos": {"x": 0, "y": 6, "w": 24, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "histogram_quantile(0.95, sum by(le, service) (rate(http_request_duration_seconds_bucket[1m])))", "legendFormat": "{{service}}"}]}
  ]
}

